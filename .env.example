# Environment Variables Example

# Database (PostgreSQL or local SQLite for development without Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tariff_forecaster
# Local SQLite fallback option: sqlite:///./tariff_forecaster.db

# API Settings
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Weather API (Open-Meteo does not require an API key)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# OCR Pluggable Interface
OCR_ENGINE=tesseract # Options: tesseract, mock, heuristics
TESSERACT_PATH=tesseract

